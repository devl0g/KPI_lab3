sequenceDiagram
  actor User as Користувач
  participant Server as Сервер платформи
  participant DB as База даних

  User->>+Server: deleteMessage(userCredentials, messageId)
  Server->>+DB: getUserDB(userId)
  DB-->>-Server: userModel
  Server->>Server: verifyUserStatus(userModel)

  break Користувач забанений/деактивований
    Server-->>User: 403 Forbidden
  end

  Server->>+DB: getMessageDB(messageId)
  DB-->>-Server: messageModel|null

  break Повідомлення не знайдено
    Server-->>User: 404 Not Found
  end

  Server->>+DB: getCommunityDB(messageModel.community_id)
  DB-->>-Server: comunityModel
  Server->>Server: verifyCommunityStatus(communityModel)

  break Спільнота не активна/призупинена
    Server-->>User: 403 Forbidden
  end

  alt messageModel.author_id = userId (користувач є автором повідомлення)
    Server->>+DB: deleteMessageDB(messageId)
    DB-->>-Server: ok
    Server-->>User: 200 OK
  else Користувач не є автором повідмолення
    Server->>+DB: getMembershipDB(communityModel.community_id, userId)
    DB-->>-Server: actorMembershipModel|null
    Server->>Server: isExists(actorMembershipModel)
    Server->>Server: isPrivilegedCommunityRole(actorMembershipModel.community_role)

    alt isExists або isPrivilegedCommunityRole повернув false
      Server-->>User: 403 Forbidden
    else Спільнотна роль привілейована
      Server->>+DB: getMembershipDB(communityModel.community_id, messageModel.author_id)
      DB-->>-Server: authorMembershipModel
      Server->>Server: isHigherCommunityRole(actorMembershipModel.community_role, authorMembershipModel.community_role)

      alt isHigherCommunityRole() повернув true
        Server->>+DB: deleteMessageDB(messageId)
        DB-->>-Server: ok
        Server-->>User: 200 OK
      else isHigherCommunityRole повертає false
        Server-->>User: 403 Forbidden
      end
    end
  end

  deactivate Server
